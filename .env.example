# Copy to .env beside docker-compose.yml and fill in. Keep it private (chmod 600 .env).

# The public host name players open, and the site password they join with.
CLOCKTOWER_DOMAIN=
CLOCKTOWER_SITE_PASSWORD=

# Pin a release instead of following :latest. Rolling back takes more than this: see README.md.
# CLOCKTOWER_IMAGE_TAG=0.5.0

# Set to 1 to send Strict-Transport-Security. Leave it off if any plain-HTTP service shares this host name: HSTS
# applies to the whole name, on every port.
# HSTS=0
