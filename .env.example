# Copy to .env and fill in. Keep .env private (chmod 600 .env).

# The public host name players will open, e.g. clocktower.example.com
CLOCKTOWER_DOMAIN=

# Shared password players enter once per device. Use something long:
# five random words is plenty, e.g. lantern-otter-violin-meadow-anchor (do not reuse this one)
CLOCKTOWER_SITE_PASSWORD=
