{
	auto_https off
	servers {
		timeouts {
			read_header 10s
			read_body 15s
			idle 2m
		}
	}
}

:8080 {
	encode gzip
	header -Server
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /icons/* Cache-Control "public, max-age=604800"
	reverse_proxy clocktower-next:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}
