# HTTPS front door for Clocktower. Caddy obtains and renews the certificates automatically.
# Caddy runs unprivileged, so it listens on high ports inside the container (see docker-compose.yml).
{
	http_port 8080
	https_port 8443
	servers {
		# Slowloris: a client that dribbles its headers or body is dropped. Upgraded sockets are not affected.
		timeouts {
			read_header 10s
			read_body 15s
			idle 2m
		}
	}
}

{$CLOCKTOWER_DOMAIN} {
	# If you cannot forward external port 80, uncomment to obtain certificates over port 443 only:
	# tls {
	# 	issuer acme {
	# 		disable_http_challenge
	# 	}
	# }
	encode gzip
	header -Server
	# Vite names these files by content, so they never change under the same name.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /icons/* Cache-Control "public, max-age=604800"
	reverse_proxy clocktower:8080 {
		# Overwrites whatever the client sent. The app trusts this header from Caddy alone.
		header_up X-Forwarded-For {remote_host}
	}
}
