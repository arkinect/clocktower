{
  "name": "clocktower",
  "private": true,
  "version": "0.5.1",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/protocol",
    "packages/rules",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @ct/server\" \"npm run dev -w @ct/web\"",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "depcruise packages/protocol packages/rules packages/server packages/web --config .dependency-cruiser.cjs",
    "boundaries:selftest": "node scripts/boundary-selftest.mjs",
    "check:role-ids": "node scripts/check-role-ids.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build -w @ct/web && npm run build -w @ct/server"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "concurrently": "^9.1.0",
    "dependency-cruiser": "^16.6.0",
    "eslint": "^10.14.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.9"
  }
}
